{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "researchcms",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "f3fe7f4b-4dd2-47fc-b178-4b3f424a3bf3",
      "database_name": "researchcms",
    },
    {
      "binding": "LEDGER",
      "database_name": "990-ledger",
      "database_id": "f1fc7465-5891-45a4-9e52-c1943980218c",
    },
    {
      "binding": "CONTRACTORS",
      "database_name": "EZPart6Contractors",
      "database_id": "451d669d-d699-4a52-a0e4-1ec7b7dd865a",
    },
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "researchcms" },
    { "binding": "R2_BUCKET", "bucket_name": "researchcms-bucket" },
    { "binding": "RESEARCH_DOCS", "bucket_name": "research-documents" },
  ],
  "queues": {
    "producers": [{ "binding": "EXTRACTION_QUEUE", "queue": "researchcms-extraction" }],
  },
  "ai": { "binding": "AI" },
}
