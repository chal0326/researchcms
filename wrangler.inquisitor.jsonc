{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "researchcms-inquisitor",
  "main": "src/worker/inquisitor.ts",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "file-type": "./src/worker/shims/file-type.js",
  },
  "observability": { "enabled": true },
  "vars": {
    "NODE_ENV": "production",
    "PAYLOAD_CONFIG_PATH": "src/payload.config.ts",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "f3fe7f4b-4dd2-47fc-b178-4b3f424a3bf3",
      "database_name": "researchcms",
    },
  ],
  "r2_buckets": [
    { "binding": "RESEARCH_DOCS", "bucket_name": "research-documents" },
    { "binding": "R2", "bucket_name": "researchcms" },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "researchcms-extraction",
        "max_batch_size": 1,
        "max_concurrency": 10,
      },
    ],
  },
  "workflows": [
    {
      "binding": "EXTRACTION_WORKFLOW",
      "name": "researchcms-extraction-workflow",
      "class_name": "ExtractionWorkflow",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "ai": { "binding": "AI" },
}
